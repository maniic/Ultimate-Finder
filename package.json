{
  "name": "ultimate-finder",
  "version": "0.1.0",
  "private": true,
  "description": "Ultimate Finder: wayfinding at U of T (CSC318 prototype).",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio --port 5555 --browser none",
    "test": "node --test"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "express": "^4.21.1",
    "pg": "^8.23.1",
    "prisma": "7.10.1"
  },
  "type": "module",
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
